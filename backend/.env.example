PORT=5000
NODE_ENV=production

MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/mymediavault

ADMIN_EMAIL=you@example.com
# Generate with: node scripts/hashPassword.js "yourStrongPassword"
ADMIN_PASSWORD_HASH=

JWT_SECRET=change_this_to_a_long_random_string
JWT_REFRESH_SECRET=change_this_to_a_different_long_random_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

CLIENT_URL=http://localhost:3000

# Storage: "local" for dev, "s3" for S3-compatible (Backblaze B2, R2, AWS S3, etc.)
STORAGE_PROVIDER=local
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=mymediavault-media
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_BASE_URL=

PAIRING_CODE_TTL_SECONDS=300
DEVICE_TOKEN_EXPIRES_IN=365d
