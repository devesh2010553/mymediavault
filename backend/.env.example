PORT=5000
NODE_ENV=production

MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/mymediavault

ADMIN_EMAIL=you@example.com
# Generate with: node scripts/hashPassword.js "yourStrongPassword"
ADMIN_PASSWORD_HASH=

JWT_SECRET=change_this_to_a_long_random_string
JWT_REFRESH_SECRET=change_this_to_a_different_long_random_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

CLIENT_URL=http://localhost:3000

# Cloudinary — all photo/video binaries live here. Get these from your
# Cloudinary dashboard (Settings > API Keys). Never commit real values.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

PAIRING_CODE_TTL_SECONDS=300
DEVICE_TOKEN_EXPIRES_IN=365d
